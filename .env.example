# ── Email capture + the movement letters ────────────────────────────
# Without these the signup form returns a friendly error and no mail sends;
# the rest of the site works normally.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Must be a verified Resend sending domain.
# Defaults to: Jesus Festival Movement <hello@team.thykingdom.net>
# (jesusfestival.ca is currently unverified on Resend — check its DNS.)
RESEND_FROM=
RESEND_REPLY_TO=Hello@JesusFestival.ca

# Supabase — THY KINGDOM NETWORK - MAIN (project ref vmpkiwfvnlzraabtjkig).
# The PUBLIC anon key is all that's needed: jfm_subscribers and jfm_email_log
# have RLS on with zero policies, and every read/write goes through
# SECURITY DEFINER RPCs (jfm_subscribe / jfm_unsubscribe / jfm_due_letters /
# jfm_claim_send / jfm_release_send). There is no service-role key to leak,
# and the anon key cannot enumerate the subscriber list.
NEXT_PUBLIC_SUPABASE_URL=https://vmpkiwfvnlzraabtjkig.supabase.co
SUPABASE_ANON_KEY=

# Gates the scheduler-only RPCs. Must match the value stored in Supabase at
#   select value from public.jfm_secrets where key = 'drip';
JFM_DRIP_SECRET=

# Absolute base URL used for links inside emails.
NEXT_PUBLIC_SITE_URL=https://www.jesusfestivalmovement.com

# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/drip.
# Generate any long random string and set it in Vercel's env vars.
CRON_SECRET=

# Set to any value to expose /api/emails/preview in production.
EMAIL_PREVIEW_ENABLED=
